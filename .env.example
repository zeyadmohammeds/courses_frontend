# Judge0 API Configuration
# WARNING: VITE_ variables are bundled into browser code.
# Do not use a private Judge0/RapidAPI key here; proxy requests through a backend instead.
VITE_JUDGE0_API_KEY=your-judge0-api-key-here
VITE_API_BASE_URL=

# Server-side API routes only — configure these in the deployment environment.
RESEND_API_KEY=your-resend-api-key
OTP_SECRET=replace-with-a-long-random-secret
